{
  "name": "mini-css-class-name",
  "version": "0.16.0",
  "description": "Minimum size unique CSS class names generator",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css-loader": {
      "types": "./css-loader/index.d.ts",
      "default": "./css-loader/index.js"
    },
    "./postcss-modules": {
      "types": "./postcss-modules/index.d.ts",
      "default": "./postcss-modules/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shoonia/mini-css-class-name.git"
  },
  "bugs": {
    "url": "https://github.com/shoonia/mini-css-class-name/issues"
  },
  "files": [
    "css-loader",
    "postcss-modules",
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "css",
    "loader",
    "css-loader",
    "getLocalIdent",
    "minify",
    "modules",
    "Identifiers",
    "webpack",
    "gatsby"
  ],
  "author": {
    "name": "Alexander Zaytsev",
    "email": "zaytsev126@gmail.com",
    "url": "https://x.com/_shoonia"
  },
  "license": "MIT"
}
